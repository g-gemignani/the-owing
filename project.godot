; Engine configuration file.
; Slay-like combat prototype.

config_version=5

[application]

config/name="The Owing"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7")

; The save directory is DECOUPLED from the game's name, which is the whole point of
; these two lines (D127). Godot derives `user://` from `config/name`, so renaming the
; game moves `app_userdata/Deckcrawl/` to `app_userdata/The Owing/` and orphans every
; existing save — with no error and no missing file, because the new directory is
; simply empty and `MetaState` reads empty as a new player. A rename is a display
; change and must never be a data migration, so the data path is nailed down here and
; the name above is free to change again.
;
; Two things about the shape of this, both learned by getting them wrong:
;
; * These keys are written WITHOUT the `application/` prefix — the section header
;   already supplies it. The fully-qualified spelling is accepted into the file,
;   ignored by the engine, and reported by nothing. Spelled that way, `user://` still
;   resolved to `app_userdata/The Owing/`: the exact silent orphaning these lines
;   exist to prevent, one layer down.
; * `use_custom_user_dir` does not rename the last segment, it drops the
;   `godot/app_userdata/` layer entirely — the directory becomes
;   `~/.local/share/Deckcrawl/`. So this pin is a MOVE, not a no-op, and the existing
;   save was copied across by hand once. `tests/run.sh` hardcodes the same path to
;   sweep its sandboxes and had to be updated with it.
config/use_custom_user_dir=true
config/custom_user_dir_name="Deckcrawl"

; The first frame of the game, and the only one Godot draws before any of this
; project's code has run — which is why all four of these are settings and not
; script (D125).
boot_splash/image="res://assets/art/ui/boot_splash.png"
; Godot's default is a 0.14 grey. The painting is a lantern in the dark averaging
; 0.075 luminance, so the default would have framed it in something four times
; brighter than the picture — the letterbox reading as the screen and the art as a
; hole in it. This is the same colour UITheme hands RenderingServer as the clear
; colour, so the splash, the bars around it and the game's own first frame are all
; one colour and nothing flashes at the handover.
boot_splash/bg_color=Color(0.07, 0.06, 0.09, 1)
; 4 = Cover. The default (1, Keep) fits the image inside the window and pads the
; rest, and `display/window/size/mode=3` means this opens FULLSCREEN on whatever
; the desktop happens to be — 16:10 here, which is exactly the aspect that hid a
; live bug in D115. Cover crops instead of padding, for the reason UI.illustration
; gives about the title screen: letterboxing reads as a bug rather than a choice.
; Safe to crop because the composition is head-on and symmetrical — the door and
; its lantern are dead centre and the frame's outer eighth is unlit stone.
boot_splash/stretch_mode=4
; Godot's default, written down because the [rendering] block below says the
; opposite for everything else. That NEAREST is for the pixel art; this is a
; painting being resized to an unknown window, and point-sampling it would put
; jagged steps on the door's arch.
boot_splash/use_filter=true

[autoload]

UITheme="*res://scripts/ui_theme.gd"
SettingsState="*res://scripts/settings_state.gd"
Audio="*res://scripts/audio.gd"
; Grouped with the three above rather than with the two state singletons below:
; like them it owns one piece of how the game presents itself, set once and left
; alone. It depends on none of them, so it could sit anywhere in this list.
Pointer="*res://scripts/pointer.gd"
MetaState="*res://scripts/meta_state.gd"
GameState="*res://scripts/game_state.gd"

[rendering]

; Pixel art: nearest-neighbour, or scaling blurs every sprite into mush.
textures/canvas_textures/default_texture_filter=0
; Required for arm64 targets — macOS universal, Android and iOS all refuse to
; export without it.
textures/vram_compression/import_etc2_astc=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Phones default to portrait; a hand of cards along the bottom of a 1280x720
; layout is unusable in it, so the game asks for landscape either way up.
window/handheld/orientation=4

[input_devices]

; Touch must generate the button presses the whole UI is built on. Hover it can
; NOT generate — see UI.touch_ui() and the tap-to-read card interaction.
pointing/emulate_mouse_from_touch=true
