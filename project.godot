; Engine configuration file.
; Slay-like combat prototype.

config_version=5

[application]

config/name="The Owing"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7")

; What build this is, shown on the main menu and in Settings by `BuildInfo` (D156).
;
; The COMMITTED value is always the dev sentinel and `tests/test_content.gd` asserts it,
; because the release channel is a rolling tag: every build is called `TheOwing-android.apk`
; and replaces the last one, so a downloaded copy is otherwise unidentifiable — which is the
; question this answers. `tools/stamp_build.sh` rewrites this line in CI, per export, to
; `0.1.0+<date>.<short sha>`; it must never be committed stamped, or every build would claim
; to be whichever one was last exported by hand.
;
; This key is read through `ProjectSettings`, so it travels in the PCK with no export filter
; to remember and no file that could be left out.
config/version="0.1.0-dev"

; The save directory is DECOUPLED from the game's name, which is the whole point of
; these two lines (D127). Godot derives `user://` from `config/name`, so renaming the
; game moves `app_userdata/Deckcrawl/` to `app_userdata/The Owing/` and orphans every
; existing save — with no error and no missing file, because the new directory is
; simply empty and `MetaState` reads empty as a new player. A rename is a display
; change and must never be a data migration, so the data path is nailed down here and
; the name above is free to change again.
;
; Two things about the shape of this, both learned by getting them wrong:
;
; * These keys are written WITHOUT the `application/` prefix — the section header
;   already supplies it. The fully-qualified spelling is accepted into the file,
;   ignored by the engine, and reported by nothing. Spelled that way, `user://` still
;   resolved to `app_userdata/The Owing/`: the exact silent orphaning these lines
;   exist to prevent, one layer down.
; * `use_custom_user_dir` does not rename the last segment, it drops the
;   `godot/app_userdata/` layer entirely — the directory becomes
;   `~/.local/share/Deckcrawl/`. So this pin is a MOVE, not a no-op, and the existing
;   save was copied across by hand once. `tests/run.sh` hardcodes the same path to
;   sweep its sandboxes and had to be updated with it.
config/use_custom_user_dir=true
config/custom_user_dir_name="Deckcrawl"

; What Godot draws before any of this project's code has run — which is why it is
; settings and not script (D125). Since D133 that is a flat colour and nothing else.
;
; D125 put a painting here: `ui/boot_splash.png`, a shut iron door at the foot of a
; stair, Cover-cropped and filtered, with no minimum display time. It was reported as
; "the screen before the main screen does not make sense, seems like a glitch", and
; it was removed because that report is literally true and the numbers say why.
;
; **A boot splash exists to cover a load, and there is no load.** A boot splash is
; drawn before the game starts, so nothing inside the game can photograph it; it was
; measured off the X framebuffer instead (Xvfb `-fbdir` mmaps the screen to disk in
; XWD, polled at ~400 Hz). The door was on screen for a mean of 287 ms — 262 to 309
; over nine boots — and deleting the shader cache moved that by nothing, because the
; menu is up 0.29 s after the window is mapped whether or not anything is cached.
; That is under llvmpipe software GL, slower than anything a player will run it on.
;
; **And it is too dark to survive being looked at that briefly.** The painting's
; MEDIAN pixel is 14/255, darker than the bg_color below at 16, with only 1.2% of the
; frame above 100 — a black rectangle with a lamp in it. MainMenu, which replaces it
; with no transition because Godot's boot splash cannot fade, means 50/255 with a
; fifth of the frame above 100. So a launch was: half a second of no window, a third
; of a second of a near-black frame with a bright speck, then a hard cut to a screen
; two and a half times brighter. There is no reading of that which is not a dropped
; frame.
;
; Two ways of saving it were tried on a copy and both are worse.
; `minimum_display_time` works — 1500 asked, 1223 ms measured on screen, the balance
; spent before the window is mapped — but it buys the picture time by charging every
; launch a second and a quarter to hide nothing, and it makes the cut at the END
; worse, because now a dark-adapted eye meets the brighter screen. Pointing the
; splash at `main_menu.png`, so the two frames are the same place, steps 75 -> 51
; instead: the menu dims and scrims that painting when it draws it and the raw file
; is not dimmed, so the "seamless" version flashes brighter and then darkens.
;
; The cropping was the one suspect that came back innocent. Cover at 5:4 — the
; harshest common desktop shape, 14.8% off each side — still frames the door, its
; lantern and both stairs whole. D125 was right about the composition and wrong about
; the brief.
;
; `ui/boot_splash.png` stays in the tree: it is still a wanted file in the manifest,
; and this decision is about what the engine shows at boot, not about the art.
boot_splash/show_image=false
; The half of D125 that was correct, and the whole of the setting now. This is the
; same colour UITheme hands RenderingServer as the clear colour, so the window opens
; as one flat field of the game's own background, holds it for the ~0.29 s the engine
; needs, and then draws the title screen. Nothing flashes at the handover because
; there is no longer a screen before the main screen to hand over FROM.
boot_splash/bg_color=Color(0.07, 0.06, 0.09, 1)

[autoload]

UITheme="*res://scripts/ui_theme.gd"
SettingsState="*res://scripts/settings_state.gd"
Audio="*res://scripts/audio.gd"
; A `Pointer` autoload used to sit here, replacing the system arrow with a painted
; iron spike and a pressed variant (D125, D133). REMOVED in D138: the game does not
; get to decide what the player's pointer looks like. The system cursor is the one
; the player configured, it is the one every other window on their machine uses, and
; a game-drawn substitute is a preference imposed rather than offered.
MetaState="*res://scripts/meta_state.gd"
GameState="*res://scripts/game_state.gd"

[rendering]

; Pixel art: nearest-neighbour, or scaling blurs every sprite into mush.
textures/canvas_textures/default_texture_filter=0
; Required for arm64 targets — macOS universal, Android and iOS all refuse to
; export without it.
textures/vram_compression/import_etc2_astc=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Phones default to portrait; a hand of cards along the bottom of a 1280x720
; layout is unusable in it, so the game asks for landscape either way up.
window/handheld/orientation=4

[input_devices]

; Touch must generate the button presses the whole UI is built on. Hover it can
; NOT generate — see UI.touch_ui() and the tap-to-read card interaction.
pointing/emulate_mouse_from_touch=true
